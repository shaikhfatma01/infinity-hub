# Copy this file to .env before running Docker Compose.
MYSQL_DATABASE=infinityhub
MYSQL_USER=infinityhub
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:8080
WEB_PORT=8080
NODE_ENV=production
STORE_DATA_MODE=demo
GEMINI_API_KEY=
